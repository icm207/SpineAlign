# Puerto del servidor
PORT=4000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar JWT (cambiar en producción)
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=12h

# Base de datos SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Umbrales de clasificación (grados absolutos)
THRESHOLD_SYMMETRIC_MAX=2
THRESHOLD_MILD_MAX=5
THRESHOLD_MODERATE_MAX=10

# Subida de archivos
UPLOAD_MAX_MB=5
UPLOAD_DIR=./uploads
